{
    "AllowedHosts": "*",
    "Serilog": {
        "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "System": "Warning",
                "Microsoft": "Information",
                "Microsoft.EntityFrameworkCore": "Information"
                //"Microsoft.EntityFrameworkCore": "Warning"
            }
        },
        "WriteTo": [
            { "Name": "Console" },
            {
                "Name": "File",
                "Args": { "path": "logs/FleetAdminApi.log" }
            }
        ],
        "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
        "Properties": {
            "Application": "Regira FleetAdmin"
        }
    },
    "Data": {
        "Storage": "FileSystem",
        "Directory": "XXX\\Data"
    },
    "Identity": {
        "SecretKey": "XXX",
        "SessionDuration": 60, // minutes
        "Audiences": [ "fleet-admin" ]
    },
    "Authentication": {
        "AccountEmails": {
            // origins (scheme://host[:port]) the SPA pages in reset/confirm links may be on; an empty list makes recovery fail
            "AllowedOrigins": [ "https://fleet.regira.com", "https://fleet-demo.regira.com", "http://localhost:5173", "http://localhost:5174" ],
            "SiteName": "Regira Fleet Admin"
        }
    },
    "Database": {
        "Accounts": {
            "Type": "MySQL",
            "ConnectionString": "Server=xxx;Port=xxx;Database=xxx_accounts;Uid=xxx;Pwd=xxx"
        },
        "Fleet": {
            "Type": "MySQL",
            "ConnectionString": "Server=xxx;Port=xxx;Database=xxx_data;Uid=xxx;Pwd=xxx"
        }
    }
}
